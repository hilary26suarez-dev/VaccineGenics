# ─────────────────────────────────────────────────────────────────────
# VaccineGenics — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────

# ── Option C: GitHub Models — EASIEST, FREE, NO CREDIT CARD ─────────
# Uses Azure AI Inference API (models.inference.ai.azure.com) = Foundry IQ
# Setup: github.com/settings/tokens → New classic token → Copy it here
# Models available: gpt-4o, gpt-4o-mini, Phi-4, Llama-3.3-70B, etc.
GITHUB_TOKEN=

# ── Option D: OpenRouter — used automatically if GITHUB_TOKEN is missing ──
# or expired/invalid. FREE Nemotron models, no credit card.
# Setup: openrouter.ai/keys → Create key → Copy it here
# Free Nemotron slugs (Jul 2026): nvidia/nemotron-3-nano-30b-a3b:free (fastest,
# good for live demos), nvidia/nemotron-3-super-120b-a12b:free (higher quality,
# slower), nvidia/nemotron-3-ultra-550b-a55b:free (best quality, slowest).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Option A: Azure AI Foundry Agents API (full mode) ────────────────
# Requires: Azure AI Foundry project + Agent Service enabled
# Get endpoint: https://ai.azure.com → your project → Overview → Endpoint
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_AGENT_MODEL=gpt-4o

# ── Option B: Azure OpenAI Chat Completions (easier mode) ────────────
# Requires ONLY: Azure OpenAI resource + gpt-4o deployment
# Get endpoint: https://portal.azure.com → Azure OpenAI → Keys and Endpoint
# This is the SIMPLEST way to get Foundry IQ working.
# Leave blank to use az login (DefaultAzureCredential) instead of API key.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=

# ── Azure AI Search (optional — enhances RAG in Agents mode) ─────────
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=vaccinegenics-knowledge

# ── NCBI E-utilities (optional — increases rate limit 3→10 req/s) ────
# Get free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ── App config ────────────────────────────────────────────────────────
COHORT_SIZE=1000
LOG_LEVEL=INFO

# ── External simulation (optional) ───────────────────────────────────
# CLUSTAN_OMEGA_ENDPOINT=https://your-endpoint.example.com/simulate
